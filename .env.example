# ============================================================
#  GBot Ultra — ejemplo de configuración
#  Copia este archivo a .env y rellena los valores.
# ============================================================

# Token de @BotFather
BOT_TOKEN=123456789:AA...

# Servidor local de la Bot API (opcional).
# Ejemplo de servidor propio: http://127.0.0.1:8081
# Vacío = API oficial de Telegram (https://api.telegram.org).
TELEGRAM_API_URL=

# PostgreSQL
DATABASE_URL=postgres://gbot:CHANGE_ME@localhost:5432/gbot
# Solo para Docker Compose: define una contraseña y usa postgres como host en DATABASE_URL.
POSTGRES_PASSWORD=

# IDs de Telegram con permisos de propietario (separados por coma)
OWNER_IDS=

# Identificador de administración de esta instalación (opcional).
DEVELOPER_TELEGRAM_ID=

# URL pública HTTPS de la Mini App (obligatoria para el botón "Panel")
# Ejemplo con Cloudflare Tunnel: https://bot.example.com
WEBAPP_URL=https://bot.example.com

# Servidor HTTP / Mini App
HOST=0.0.0.0
PORT=8090

# polling | webhook | off
BOT_MODE=polling

# interval (servidor permanente) | external (Namecheap/Passenger + cron de respaldo)
SCHEDULER_MODE=interval
INTERNAL_CRON_SECRET=
# Opcional: destinatario privado de los avisos de caída/recuperación del monitor del hosting.
# Vacío = solo panel. El monitor se ejecuta con scripts/run-cron.mjs.
MONITOR_ALERT_CHAT_ID=
# En Passenger: false. Ejecutar scripts/activate-hosting.mjs una vez al desplegar.
CONFIGURE_BOT_ON_START=true
REGISTER_WEBHOOK_ON_START=true

# Webhook (recomendado en producción; requiere HTTPS)
WEBHOOK_URL=
WEBHOOK_SECRET=

# true = autenticación de desarrollo para la Mini App (NUNCA en producción)
DEV_MODE=false

# Enlaces del bot
SUPPORT_URL=https://t.me/tu_usuario
CHANNEL_URL=

# Límites y comportamiento
LOG_LEVEL=info
TZ=Europe/Madrid
FREE_ACTION_LIMIT=200
PREMIUM_ACTION_LIMIT=5000
CAPTCHA_TIMEOUT_SECONDS=300
PREMIUM_REMINDER_DAYS=3

# Publicidad (solo para grupos/cuentas gratuitas)
AD_BANNER_ENABLED=true
AD_BANNER_TEXT=Patrocinado: mejora tu grupo con GBot Ultra Premium
AD_BANNER_URL=https://t.me/GroupButlerEsp_bot?start=premium
AD_SPONSORED_ENABLED=true
AD_SPONSORED_TEXT=Patrocinado: desbloquea Premium con Telegram Stars
AD_SPONSORED_URL=https://t.me/GroupButlerEsp_bot?start=premium

# CAS gratuito para todos los grupos; guardar la clave solo en .env privada.
CAS_ENABLED=false
CAS_API_KEY=

# Endpoint gratuito de OpenAI Moderation, sin generación de respuestas.
# Cada grupo debe autorizar y activar el filtro desde la Mini App.
OPENAI_MODERATION_API_KEY=

# IA: usar exclusivamente una cuenta Groq en plan gratuito.
GROQ_FREE_API_KEY=
# Cifrado privado AES-256-GCM: 32 bytes en base64. Crear una vez y respaldar; no rotar.
BOT_VAULT_KEY=

# Opcional, solo cron del hosting: IP de su interfaz HTTPS y CA de confianza.
# Conservar WEBAPP_URL/SNI; nunca desactivar validación TLS.
SCHEDULER_ORIGIN_IP=
SCHEDULER_ORIGIN_CA_FILE=
